# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/truva

# Redis
REDIS_URL=redis://localhost:6379

# Solana (Powered by RPC Fast — https://rpcfast.com)
SOLANA_RPC_URL=https://solana-devnet.rpcfast.com?api_key=YOUR_RPCFAST_API_KEY
TRUVA_PROGRAM_ID=BTgy2r8R85Jknq3JetNiVt1x9grdccm7pTV2LyUmDzG5
BACKEND_AUTHORITY_KEY=your_base58_encoded_keypair

# Helius
HELIUS_API_KEY=your_helius_api_key
HELIUS_WEBHOOK_SECRET=your_webhook_secret

# SDK
TRUVA_API_URL=http://localhost:3001

# API Authentication (optional — if not set, all requests allowed)
API_KEY=your_api_key_here

# Supabase (for syncing scores back to the Next.js frontend DB)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Risk monitor (automatic kill switch)
# When true, a passport is frozen on-chain if the agent's recent activity is anomalous
AUTO_FREEZE_ENABLED=false
RISK_WINDOW_SECS=600
RISK_MAX_TX=30
RISK_MAX_COUNTERPARTIES=15
RISK_MIN_TX_FOR_FAILURE_RATE=10
RISK_MAX_FAILURE_RATE=0.6

# Solana Agent Registry (ERC-8004) reputation signal — read-only
AGENT_REGISTRY_CLUSTER=mainnet-beta
# Mainnet RPC for registry reads (RPC Fast recommended)
AGENT_REGISTRY_RPC_URL=https://solana-rpc.rpcfast.com?api_key=YOUR_RPCFAST_API_KEY
AGENT_REGISTRY_REFRESH_SECS=3600
